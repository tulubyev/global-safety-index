DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=safety_db
# From inside Docker the host is 172.28.0.1, not the server's public IP
DATABASE_URL=postgres://user:password@172.28.0.1:5432/safety_db

# Optional — without Redis requests fall through to the database
REDIS_URL=redis://localhost:6379
ML_SERVICE_URL=http://localhost:8000
PORT=3001

# ReliefWeb — register appname at https://apidoc.reliefweb.int/parameters#appname (~1 business day)
RELIEFWEB_APPNAME=your-approved-appname

# Manual pipeline trigger via POST /api/admin/run-update.
# Leave empty to keep the endpoint disabled. 16+ characters when set.
ADMIN_TOKEN=

# FCM push notifications (optional)
FCM_SERVER_KEY=your_fcm_server_key_here
